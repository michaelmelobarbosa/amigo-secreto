# Valores com espaço exigem aspas, porque os scripts carregam o .env com "source".
# Exemplo: BREVO_FROM_NAME="Amigo Secreto". Evite $, #, = e aspas simples dentro dos valores.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/amigo_secreto
SPRING_DATASOURCE_USERNAME=amigo
SPRING_DATASOURCE_PASSWORD=amigo
APP_BASE_URL=http://localhost:8080
# Em produção use https://<dominio> e SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SECURE=false

# E-mail (fase 2). Em dev/test, deixe EMAIL_ENABLED=false e BREVO_SANDBOX=true.
EMAIL_ENABLED=false
EMAIL_WORKER_ENABLED=true
BREVO_API_KEY=
BREVO_FROM_EMAIL=no-reply@mail.barbosalabs.dev
BREVO_FROM_NAME="Amigo Secreto"
BREVO_REPLY_TO=
BREVO_SANDBOX=true
