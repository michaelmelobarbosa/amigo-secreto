# Exemplo de configuração de produção do Amigo Secreto.
#
# Copie para .env NO SERVIDOR (mesma pasta deste repositório) e preencha:
#   cp .env.prod.example .env
#   chmod 600 .env
#
# O arquivo .env nunca vai para o Git (o .gitignore já ignora .env e .env.*).
# Este exemplo (.env.prod.example) é versionado; o .env real é ignorado.
#
# Gere a senha com: openssl rand -hex 32
# Evite espaços, "#" e "=" dentro dos valores: os scripts carregam este arquivo com "source".

# Banco (criado pelo container postgres na primeira subida; manter estável depois).
POSTGRES_DB=amigo_secreto
POSTGRES_USER=amigo
POSTGRES_PASSWORD=troque-por-uma-senha-aleatoria-longa-ex-64-hex

# Domínio público SEM barra final e SEM esquema (o Caddy emite o certificado para ele).
# O DNS precisa ter registro A (e AAAA, se houver IPv6) apontando para a VPS.
DOMAIN=amigo.exemplo.com

# E-mail usado pelo Let's Encrypt para avisos de expiração do certificado.
ACME_EMAIL=voce@exemplo.com

# E-mail (fase 2). Para produção, EMAIL_ENABLED=true e BREVO_SANDBOX=false.
# A API key deve ser a chave de produção (separada da usada em dev).
EMAIL_ENABLED=false
EMAIL_WORKER_ENABLED=true
BREVO_API_KEY=
BREVO_FROM_EMAIL=no-reply@mail.barbosalabs.dev
BREVO_FROM_NAME=Amigo Secreto
BREVO_REPLY_TO=
BREVO_SANDBOX=false
