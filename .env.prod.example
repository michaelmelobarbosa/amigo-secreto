# Exemplo de configuração de produção do Amigo Secreto.
#
# Copie para .env NO SERVIDOR (mesma pasta deste repositório) e preencha:
#   cp .env.prod.example .env
#   chmod 600 .env
#
# O arquivo .env nunca vai para o Git (o .gitignore já ignora .env e .env.*).
# Este exemplo (.env.prod.example) é versionado; o .env real é ignorado.
#
# Gere a senha com: openssl rand -hex 32
# Valores com espaço exigem aspas (ex.: BREVO_FROM_NAME="Amigo Secreto"), porque os scripts
# carregam o .env com "source". Evite $, #, = e aspas simples dentro dos valores.

# Banco (criado pelo container postgres na primeira subida; manter estável depois).
POSTGRES_DB=amigo_secreto
POSTGRES_USER=amigo
POSTGRES_PASSWORD=troque-por-uma-senha-aleatoria-longa-ex-64-hex

# Domínio público SEM barra final e SEM esquema (o Caddy de borda emite o certificado).
# O DNS precisa ter registro A (e AAAA, se houver IPv6) apontando para a VPS.
# ACME_EMAIL fica no .env do stack de borda, não neste arquivo.
DOMAIN=amigo-secreto.barbosalabs.dev

# Imagem publicada pelo CI no GitHub Container Registry.
# APP_TAG deve ser o SHA do commit (tag imutável); nunca use "latest" em produção.
APP_IMAGE=ghcr.io/michaelmelobarbosa/amigo-secreto
APP_TAG=troque-pelo-sha-do-commit

# Rede externa compartilhada com o Caddy de borda.
EDGE_NETWORK=edge

# Rate limiting em memória por IP (ver docs/RATE-LIMITING.md).
# Limites generosos de propósito; o sorteio usa a janela de 1 hora.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_EVENT_CREATE=5
RATE_LIMIT_JOIN=30
RATE_LIMIT_DRAW=10
RATE_LIMIT_WISHLIST=30
RATE_LIMIT_WINDOW=PT10M
RATE_LIMIT_DRAW_WINDOW=PT1H
RATE_LIMIT_MAX_KEYS=10000

# E-mail (fase 2). Para produção, EMAIL_ENABLED=true e BREVO_SANDBOX=false.
# A API key deve ser a chave de produção (separada da usada em dev).
# IP de saída da VPS para allowlist do Brevo: 147.15.121.26.
# Depois de preencher, valide com scripts/check-brevo.sh e scripts/smoke-email.sh.
EMAIL_ENABLED=false
EMAIL_WORKER_ENABLED=true
BREVO_API_KEY=
BREVO_FROM_EMAIL=no-reply@mail.barbosalabs.dev
BREVO_FROM_NAME="Amigo Secreto"
BREVO_REPLY_TO=
BREVO_SANDBOX=false
